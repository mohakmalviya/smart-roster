# Postgres connection string for the shared database (api/state.ts, api/roster.ts).
# On Vercel, connecting a Neon database sets this for you. Leave empty to keep data in the browser.
DATABASE_URL=

# Server-side key for the "Explain with AI" button (api/explain.ts).
# Get one at https://platform.claude.com — never commit the real value.
ANTHROPIC_API_KEY=
